# Installed into the live environment on top of the stock Omarchy/Oparysh ISO, which
# already carries Arch's releng rescue set (ddrescue, testdisk, smartmontools,
# nvme-cli, fsarchiver, partclone, clonezilla, btrfs-progs, cryptsetup, lvm2,
# mdadm, parted, gptfdisk, nmap, tcpdump, rsync, tmux, and more).

# Local AI (halal). No Claude, no Codex, no OpenCode.
ollama

# EBLAN Browser system deps (sources + eblanity binary are vendored at build time
# by builder/vendor-eblan.sh into airootfs — fully offline after the ISO is built).
python
python-pip
python-pyqt6
python-pyqt6-webengine
python-requests
python-httpx
python-pydantic
xcb-util-cursor
xcb-util-image
xcb-util-keysyms
xcb-util-renderutil
xcb-util-wm
libxkbcommon-x11
mesa
fontconfig
dbus
nss
alsa-lib
libxcomposite
libxdamage
libxrandr
gtk3
libxslt
ffmpeg
unzip

# Console: kmscon for real fonts and truecolor without a desktop, ttyd and
# qrencode to hand the session to a phone, impala for Wi-Fi over iwd
kmscon
ttf-jetbrains-mono-nerd
ttyd
qrencode
impala

# The Oparysh shell the live root already gets from settings
starship
zoxide
fzf
eza
bat

# Disks, filesystems, and boot repair
chntpw
os-prober
sbctl
limine
wimlib
sleuthkit
foremost

# Hardware diagnosis
lshw
hwinfo
inxi
lm_sensors
i2c-tools
memtester
stress-ng
fastfetch

# System inspection
btop
htop
iotop
lsof
strace
ncdu
gdu

# Backup and data transfer
rclone
restic
borg
7zip
zip
wget

# Network diagnosis
mtr
iperf3
socat
whois

# For tools and humans working in the shell
git
github-cli
neovim
ripgrep
fd
