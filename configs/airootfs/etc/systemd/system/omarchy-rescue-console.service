# Primary Oparysh Chinila session: Hyprland on tty1.
# Kernel cmdline still uses omarchy.rescue=kms so GRUB entries stay valid.
# If Hyprland fails, OnFailure starts the plain autologin getty.

[Unit]
Description=Oparysh Chinila Hyprland on tty1
After=systemd-user-sessions.service
After=plymouth-quit-wait.service
After=systemd-vconsole-setup.service
After=seatd.service
Before=getty.target
OnFailure=omarchy-rescue-getty.service
IgnoreOnIsolate=yes
ConditionKernelCommandLine=omarchy.rescue=kms
ConditionPathExists=/dev/tty0

[Service]
Type=simple
User=root
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=Hyprland
ExecStart=/usr/local/bin/oparysh-hyprland-session
Restart=on-failure
RestartSec=2

[Install]
WantedBy=getty.target
