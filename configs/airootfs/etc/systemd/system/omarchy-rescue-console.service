# Primary Oparysh Chinila session: Hyprland on tty1.
# Boot with oparysh.rescue=kms (legacy omarchy.rescue=kms still accepted).

[Unit]
Description=Oparysh Chinila Hyprland on tty1
After=systemd-user-sessions.service
After=plymouth-quit-wait.service
After=systemd-vconsole-setup.service
After=seatd.service
Before=getty.target
OnFailure=omarchy-rescue-getty.service
IgnoreOnIsolate=yes
ConditionKernelCommandLine=|oparysh.rescue=kms
ConditionKernelCommandLine=|omarchy.rescue=kms
ConditionPathExists=/dev/tty0

[Service]
Type=simple
User=root
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=Hyprland
Environment=HOME=/root
ExecStartPre=/usr/local/bin/oparysh-rebrand
ExecStart=/usr/local/bin/oparysh-hyprland-session
Restart=on-failure
RestartSec=2

[Install]
WantedBy=getty.target
