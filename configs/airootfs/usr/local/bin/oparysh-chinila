#!/bin/bash

# Oparysh Chinila: welcome screen + menu over rescue helpers.

welcome() {
  local logo=/usr/share/oparysh-chinila/logo.txt
  [[ -f $logo ]] || logo=/usr/share/omarchy/logo.txt
  if [[ -f $logo ]]; then
    if command -v gum >/dev/null 2>&1; then
      gum style --foreground 2 "$(<"$logo")" && echo
    else
      printf '\033[32m%s\033[0m\n\n' "$(<"$logo")"
    fi
  fi

  if command -v gum >/dev/null 2>&1; then
    gum style --foreground 4 --bold "Oparysh Chinila"
  else
    printf '\033[34m\033[1mOparysh Chinila\033[0m\n'
  fi
  cat <<'TEXT'
A live Oparysh console with rescue tools, Eblan Browser, Eblanity and local
halal AI models. Nothing here touches your disks until you ask it to.

  oparysh-chinila         menu of everything below
  impala                  connect to Wi-Fi (Ethernet just works)
  oparysh-chinila-mount   unlock and mount your install at /mnt
  arch-chroot /mnt        run commands inside your installed system
  oparysh-chinila-share   drive this console from your phone's browser
  eblan                   Eblan Browser (halal, offline)
  eblanity                Eblanity CLI (offline)
  ollama                  local AI models (halal)

  C-space u               open the last link on screen on your phone
  C-space o               open the menu in a new window
TEXT
  echo
}

online() {
  curl -s -m 5 -o /dev/null https://archlinux.org
}

require_online() {
  online && return
  if command -v gum >/dev/null 2>&1; then
    gum style --foreground 3 "No internet connection yet. Connect Wi-Fi with impala, or plug in Ethernet."
  else
    echo "No internet connection yet. Connect Wi-Fi with impala, or plug in Ethernet."
  fi
  return 1
}

update_tools() {
  require_online || return
  pacman -Sy --needed --noconfirm archlinux-keyring &&
    pacman -S --noconfirm ollama
}

chroot_installed() {
  mountpoint -q /mnt || oparysh-chinila-mount || return
  arch-chroot /mnt
}

start_eblan() {
  if command -v eblan >/dev/null && [[ -f /opt/eblan-browser/EBLAN.py ]]; then
    eblan
  else
    echo "Eblan Browser not vendored into this ISO."
  fi
}

start_eblanity() {
  if command -v eblanity >/dev/null && [[ -x $(command -v eblanity) ]]; then
    eblanity
  else
    echo "Eblanity not vendored into this ISO."
  fi
}

menu() {
  local choice
  while true; do
    if ! command -v gum >/dev/null 2>&1; then
      echo "Oparysh Chinila — type a command (eblan, impala, ...)"
      return 0
    fi
    choice=$(gum choose --header "Oparysh Chinila" \
      "Start Eblan Browser" \
      "Start Eblanity" \
      "Start local AI (ollama)" \
      "Connect to Wi-Fi" \
      "Share this console with a phone" \
      "Mount installed system at /mnt" \
      "Chroot into installed system" \
      "Update tools" \
      "Exit to shell") || return 0

    case $choice in
    "Start Eblan Browser") start_eblan ;;
    "Start Eblanity") start_eblanity ;;
    "Start local AI (ollama)") ollama serve & sleep 1; ollama run llama3.2 ;;
    "Connect to Wi-Fi") impala ;;
    "Share this console with a phone") oparysh-chinila-share ;;
    "Mount installed system at /mnt") oparysh-chinila-mount ;;
    "Chroot into installed system") chroot_installed ;;
    "Update tools") update_tools ;;
    "Exit to shell") return 0 ;;
    esac

    echo
    gum input --placeholder "Press Enter to return to the menu" >/dev/null || return 0
  done
}

case ${1:-menu} in
welcome) welcome ;;
menu) menu ;;
update) update_tools ;;
*)
  echo "Usage: oparysh-chinila [welcome|menu|update]" >&2
  exit 1
  ;;
esac
